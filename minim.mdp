; minim.mdp — Energy Minimization Parameters
; Method  : Steepest Descent
; Force Field: CHARMM36 | Water: TIP3P
; Author  : Linta Mahboob | University of Siena
; ─────────────────────────────────────────────────────────────────────────────

; --- Run Control ─────────────────────────────────────────────────────────────
integrator              = steep     ; Steepest descent energy minimization
nsteps                  = 50000     ; Maximum number of minimization steps
emtol                   = 1000.0   ; Stop when max force < 1000 kJ/mol/nm
emstep                  = 0.01     ; Initial step size (nm)

; --- Neighbour Searching ─────────────────────────────────────────────────────
cutoff-scheme           = Verlet   ; Buffered pair-list (recommended for GROMACS 5+)
nstlist                 = 10       ; Frequency to update neighbour list
ns_type                 = grid     ; Grid-based neighbour searching

; --- Electrostatics ──────────────────────────────────────────────────────────
coulombtype             = PME      ; Particle Mesh Ewald for long-range electrostatics
rcoulomb                = 1.2      ; Short-range electrostatic cutoff (nm)
pme_order               = 4        ; PME interpolation order
fourierspacing          = 0.16     ; Grid spacing for FFT (nm)

; --- Van der Waals ───────────────────────────────────────────────────────────
vdwtype                 = Cut-off
rvdw                    = 1.2      ; VdW cutoff (nm) — consistent with CHARMM36
rvdw-switch             = 1.0      ; Start switch function at 1.0 nm
vdw-modifier            = Force-switch   ; CHARMM36 recommended modifier
DispCorr                = EnerPres ; Long-range dispersion correction for E and P

; --- Periodic Boundary Conditions ────────────────────────────────────────────
pbc                     = xyz      ; Full 3D PBC
