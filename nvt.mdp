; nvt.mdp — NVT Equilibration Parameters (Canonical Ensemble)
; Purpose : Equilibrate temperature to 300 K with position restraints on solute
; Duration: 100 ps (50,000 steps × 2 fs)
; Force Field: CHARMM36 | Water: TIP3P
; Author  : Linta Mahboob | University of Siena
; ─────────────────────────────────────────────────────────────────────────────

; --- Run Control ─────────────────────────────────────────────────────────────
integrator              = md       ; Leap-frog integrator
dt                      = 0.002    ; Timestep: 2 fs
nsteps                  = 50000    ; 100 ps equilibration
comm-mode               = Linear   ; Remove centre-of-mass translation
nstcomm                 = 100

; --- Output Control ──────────────────────────────────────────────────────────
nstxout                 = 500      ; Write coordinates every 1 ps
nstvout                 = 500      ; Write velocities every 1 ps
nstenergy               = 500      ; Write energies every 1 ps
nstlog                  = 500      ; Write log every 1 ps
nstxout-compressed      = 500      ; Write compressed trajectory (.xtc)

; --- Bonds ───────────────────────────────────────────────────────────────────
continuation            = no       ; First equilibration step — generate velocities
constraint_algorithm    = lincs    ; LINCS for holonomic constraints
constraints             = h-bonds  ; Constrain H-bonds (allows 2 fs timestep)
lincs-iter              = 1
lincs-order             = 4

; --- Neighbour Searching ─────────────────────────────────────────────────────
cutoff-scheme           = Verlet
nstlist                 = 10
ns_type                 = grid
rlist                   = 1.2

; --- Electrostatics ──────────────────────────────────────────────────────────
coulombtype             = PME
rcoulomb                = 1.2
pme_order               = 4
fourierspacing          = 0.16

; --- Van der Waals ───────────────────────────────────────────────────────────
vdwtype                 = Cut-off
rvdw                    = 1.2
rvdw-switch             = 1.0
vdw-modifier            = Force-switch
DispCorr                = EnerPres

; --- Temperature Coupling (V-rescale) ─────────────────────────────────────────
tcoupl                  = V-rescale          ; Velocity rescaling thermostat
tc-grps                 = Protein_LIG Water_and_ions  ; Separate coupling groups
tau_t                   = 0.1       0.1      ; Time constant (ps)
ref_t                   = 300       300      ; Reference temperature (K)

; --- Pressure Coupling ───────────────────────────────────────────────────────
pcoupl                  = no       ; No pressure coupling in NVT

; --- Velocity Generation ─────────────────────────────────────────────────────
gen_vel                 = yes      ; Generate initial velocities
gen_temp                = 300      ; Temperature for Maxwell-Boltzmann distribution
gen_seed                = -1       ; Random seed

; --- Periodic Boundary Conditions ────────────────────────────────────────────
pbc                     = xyz

; --- Position Restraints ─────────────────────────────────────────────────────
; Applied to protein heavy atoms and ligand during equilibration
; Restraint force constants defined in posre.itp / LIG_posre.itp
define                  = -DPOSRES ; Activates position restraints on protein + ligand
