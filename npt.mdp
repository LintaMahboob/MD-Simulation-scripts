; npt.mdp — NPT Equilibration Parameters (Isothermal-Isobaric Ensemble)
; Purpose : Equilibrate pressure to 1 atm with position restraints on solute
; Duration: 100 ps (50,000 steps × 2 fs)
; Conditions: 300 K, 1 bar (physiological)
; Force Field: CHARMM36 | Water: TIP3P
; Author  : Linta Mahboob | University of Siena
; ─────────────────────────────────────────────────────────────────────────────

; --- Run Control ─────────────────────────────────────────────────────────────
integrator              = md
dt                      = 0.002    ; 2 fs timestep
nsteps                  = 50000    ; 100 ps
comm-mode               = Linear
nstcomm                 = 100

; --- Output Control ──────────────────────────────────────────────────────────
nstxout                 = 500
nstvout                 = 500
nstenergy               = 500
nstlog                  = 500
nstxout-compressed      = 500

; --- Bonds ───────────────────────────────────────────────────────────────────
continuation            = yes      ; Continue from NVT
constraint_algorithm    = lincs
constraints             = h-bonds
lincs-iter              = 1
lincs-order             = 4

; --- Neighbour Searching ─────────────────────────────────────────────────────
cutoff-scheme           = Verlet
nstlist                 = 10
ns_type                 = grid
rlist                   = 1.2

; --- Electrostatics ──────────────────────────────────────────────────────────
coulombtype             = PME
rcoulomb                = 1.2
pme_order               = 4
fourierspacing          = 0.16

; --- Van der Waals ───────────────────────────────────────────────────────────
vdwtype                 = Cut-off
rvdw                    = 1.2
rvdw-switch             = 1.0
vdw-modifier            = Force-switch
DispCorr                = EnerPres

; --- Temperature Coupling ────────────────────────────────────────────────────
tcoupl                  = V-rescale
tc-grps                 = Protein_LIG Water_and_ions
tau_t                   = 0.1       0.1
ref_t                   = 300       300

; --- Pressure Coupling (Berendsen — for equilibration only) ──────────────────
pcoupl                  = Berendsen         ; Berendsen barostat for equilibration
pcoupltype              = isotropic
tau_p                   = 2.0              ; Time constant for pressure coupling (ps)
ref_p                   = 1.0              ; Reference pressure (bar)
compressibility         = 4.5e-5           ; Isothermal compressibility of water (bar⁻¹)
refcoord_scaling        = com              ; Scale reference coordinates with COM

; --- Velocity Generation ─────────────────────────────────────────────────────
gen_vel                 = no               ; Velocities carried over from NVT

; --- Periodic Boundary Conditions ────────────────────────────────────────────
pbc                     = xyz

; --- Position Restraints ─────────────────────────────────────────────────────
define                  = -DPOSRES         ; Keep position restraints active
